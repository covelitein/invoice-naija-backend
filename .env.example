# Server Environment
PORT=10000
NODE_ENV=production

# Frontend Origin for CORS (e.g. your Vercel domain in production, localhost in development)
FRONTEND_URL=https://your-invoice-app.vercel.app

# Database: MySQL Connection String
# Formats supported:
# mysql://<username>:<password>@<host>:<port>/<database>?ssl={"rejectUnauthorized":true}
#
# Free cloud MySQL providers (e.g. TiDB Cloud Serverless, PlanetScale, Aiven MySQL, Clever Cloud):
# Example: mysql://2XabcDEF.root:SecretPassword123@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/invoicenaija?ssl={"rejectUnauthorized":true}
DATABASE_URL=

# Google AI Studio / Gemini API Key (optional but recommended for AI invoice drafting)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
